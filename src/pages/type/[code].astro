---
import Base from '../../layouts/Base.astro';
import typesJson from '../../data/types.json';
import axesJson from '../../data/axes.json';
import type { AxisKey, CrystalType } from '../../engine/types';

const TYPES = typesJson as Record<string, CrystalType>;
const AXES = axesJson as Record<AxisKey, {
  name: string; pos: string; neg: string; posLabel: string; negLabel: string; desc: string;
}>;

/**
 * 16개 유형이 각각 독립된 주소를 갖는다.
 * 이게 v1과 가장 크게 달라지는 지점이다 —
 *   · 공유 링크에 유형별 썸네일이 뜬다 (v1은 페이지가 하나뿐이라 불가능했다)
 *   · 검색엔진에 16개 페이지가 색인된다
 */
export function getStaticPaths() {
  const types = typesJson as Record<string, CrystalType>;
  return Object.keys(types).map(code => ({ params: { code } }));
}

const { code } = Astro.params;
const t = TYPES[code!];

const AXIS_ORDER: AxisKey[] = ['sp', 'ex', 'st', 'iv'];
const poles = AXIS_ORDER.map((k, i) => {
  const letter = code![i];
  const isPos = letter === AXES[k].pos;
  return {
    axis: AXES[k].name,
    label: isPos ? AXES[k].posLabel : AXES[k].negLabel,
    desc: AXES[k].desc,
    letter,
  };
});
---
<Base
  title={`${t.name} · ${t.gem} — Crush Lab`}
  description={`${t.tag} ${t.sum}`}
  image={`/art/og/${code}.svg`}
>
  <div class="doc">
    <a class="crumb" href="/">← Crush Lab</a>

    <div>
      <p>{t.gem}</p>
      <h1>{t.name}</h1>
      <p class="lead">{t.mz}</p>
      <p>{t.tag}</p>
    </div>

    <p class="lead">{t.sum}</p>
    <p>{t.why}</p>

    <h2>네 축은 이렇게 나와</h2>
    <div class="grid">
      {poles.map(p => (
        <div class="tile">
          <b>{p.label}</b>
          <span>{p.axis} · {p.letter}</span>
        </div>
      ))}
    </div>

    <h2>너는 어떤 크리스탈일까</h2>
    <a class="cta" href="/play">검사하러 가기</a>
  </div>
</Base>
